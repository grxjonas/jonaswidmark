---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
const { title, subtitle, date } = frontmatter;

const formattedDate = date
  ? new Date(date).toLocaleDateString("en-GB", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<Layout title={title}>
  <article>
    <header>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      {formattedDate && <p class="date">{formattedDate}</p>}
    </header>
    <slot />
    <footer>
      <a href="/">← Home</a>
    </footer>
  </article>
  <style>
    header {
      margin-bottom: 2.5rem;
    }
    h1 {
      font-size: 1.9rem;
      margin-bottom: 0.4rem;
    }
    .subtitle {
      font-size: 1.2rem;
      color: var(--muted);
      font-style: italic;
      margin: 0 0 0.8rem;
    }
    .date {
      font-size: 0.85rem;
      color: var(--muted);
      margin: 0;
    }
    article :global(p) {
      margin: 0 0 1.3rem;
    }
    footer {
      margin-top: 4rem;
      padding-top: 1.5rem;
      border-top: 1px solid #e5e5e2;
      font-size: 0.9rem;
    }
  </style>
</Layout>