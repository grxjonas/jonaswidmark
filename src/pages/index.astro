---
import Layout from "../layouts/Layout.astro";
const posts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true })
);
posts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);
function fmt(date) {
  return new Date(date).toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---
<Layout title="Jonas Widmark">
  <header>
    <h1>Jonas Widmark</h1>
    <p class="tagline">
      The true distance between a good idea and landing it in an organisation.
    </p>
  </header>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={post.url}>{post.frontmatter.title}</a>
        <time>{fmt(post.frontmatter.date)}</time>
      </li>
    ))}
  </ul>
  <style>
    header {
      margin-bottom: 3rem;
    }
    h1 {
      font-size: 1.05rem;
      font-weight: 400;
      letter-spacing: 0.02em;
      margin: 0 0 0.3rem;
    }
    .tagline {
      font-size: 1rem;
      font-style: italic;
      color: var(--muted);
      margin: 0;
    }
    .posts {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .posts li {
      display: flex;
      align-items: baseline;
      gap: 1.5rem;
      padding: 0.5rem 0;
    }
    .posts a {
      text-decoration: none;
      flex: 1;
    }
    .posts a:hover {
      text-decoration: underline;
    }
    .posts time {
      font-size: 0.85rem;
      color: var(--muted);
      white-space: nowrap;
      flex-shrink: 0;
      width: 7rem;
      text-align: right;
    }
  </style>
</Layout>
